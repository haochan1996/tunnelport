# 行尾与二进制规范（Windows 开发必备）
# shell 脚本必须 LF：CRLF 会让服务器上 /bin/sh^M: bad interpreter
* text=auto

*.sh    text eol=lf
*.ps1   text eol=crlf
*.go    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.json  text eol=lf
*.toml  text eol=lf

# 二进制资产：禁止任何行尾转换
*.png   binary
*.ico   binary
*.syso  binary
*.p12   binary
*.zip   binary
